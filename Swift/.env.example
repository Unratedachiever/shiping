# SwiftShip Logistics — example environment (no real secrets)

# Leave unset to use embedded PGlite. Set for Neon/Postgres in production.
# DATABASE_URL=postgres://user:pass@host:5432/swiftship

# Auth UI: "false" uses a local dev user when no DATABASE_URL is set.
# Deployers typically force "true".
VITE_AUTH_ENABLED=true

# Better Auth (required when auth is enabled in production)
# BETTER_AUTH_URL=https://your-app.example.com
# BETTER_AUTH_SECRET=generate-a-long-random-string

# Optional Grok auth broker (federated Google/X via shared issuer)
# GROK_AUTH_ISSUER=https://auth.example.com
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=

# Set by the deployer on publish; absence means workspace preview mode.
# GROK_PROJECT_ID=

# Optional gate origin for preview identity
# GROK_GATE_ORIGIN=
